[Unit]
Description=Echo Dot soft-volume auto-wiring daemon
After=pipewire.service pipewire-pulse.service wireplumber.service
PartOf=graphical-session.target

[Service]
# Replace with your Bluetooth speaker MAC
Environment=BT_MAC=AA:BB:CC:DD:EE:FF
Type=simple
ExecStart=%h/.local/bin/echo-softvol-watch
Restart=always
RestartSec=3

[Install]
WantedBy=graphical-session.target
