[Unit]
Description=Bluetooth speaker echo-cancel auto-wiring daemon
After=pipewire.service pipewire-pulse.service wireplumber.service
# On Omarchy/uwsm, graphical-session.target is reached when the Hyprland session starts.
PartOf=graphical-session.target

[Service]
# BT_MAC=... and optionally MIC=... (created by install.sh)
EnvironmentFile=%h/.config/echo-softvol/env
Type=simple
ExecStart=%h/.local/bin/echo-softvol-watch
Restart=always
RestartSec=3

[Install]
WantedBy=graphical-session.target
